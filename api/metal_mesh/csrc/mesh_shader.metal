#include <metal_stdlib>
using namespace metal;

// ─── Metal 3.0 Mesh Shader Pipeline for Meshlet-Based Rendering ──────────────
//
// Mesh shaders (Metal 3.0, macOS 13.0+) provide a GPU-driven rendering pipeline
// that replaces the traditional vertex shader with a two-stage approach:
//
//   1. Object shader: Determines which meshlets to render and sets up payload data
//   2. Mesh shader: Generates vertices and primitives for each meshlet
//
// This pipeline is designed for GPU-driven culling and rendering of 3D meshes
// generated by Modly's image-to-3D pipeline. It enables:
//   - GPU-driven frustum and occlusion culling (no CPU readback)
//   - Procedural geometry generation
//   - Fine-grained LOD control per meshlet
//   - Better utilization of Apple Silicon's unified memory architecture
//
// On M4, mesh shaders leverage the enhanced GPU pipeline with 32-wide
// simdgroups and improved threadgroup memory for maximum throughput.
//
// This native Metal rendering path is available for headless preview rendering
// and future native Metal viewer integration. The current WebGL viewer in
// Electron continues to use three.js for interactive 3D display.

// ─── Data structures ─────────────────────────────────────────────────────────

struct VertexOut {
    float4 position [[position]];
    float3 normal;
    float2 uv;
    float4 color;
};

struct PrimitiveOut {
    float3 normal;
};

struct Meshlet {
    uint32_t vertexOffset;      // Offset into the global vertex buffer
    uint32_t triangleOffset;    // Offset into the local index buffer
    uint32_t vertexCount;       // Number of vertices in this meshlet
    uint32_t triangleCount;     // Number of triangles in this meshlet
    float3 center;              // Bounding sphere center (model space)
    float radius;               // Bounding sphere radius
};

struct MeshletIndex {
    uint32_t v0;
    uint32_t v1;
    uint32_t v2;
};

struct CameraData {
    float4x4 viewProjection;
    float4x4 view;
    float3 cameraPos;
    float _pad;
};

struct ObjectPayload {
    float4x4 modelMatrix;
    uint32_t meshletOffset;
    uint32_t meshletCount;
    float3 boundingSphereCenter;
    float boundingSphereRadius;
};

// ─── Object shader (first stage) ─────────────────────────────────────────────
// Runs once per object (threadgroup). Performs frustum culling and determines
// how many mesh shader threadgroups to dispatch for this object.

[[object]]
void object_main(
    uint objectID [[threadgroup_position_in_grid]],
    constant ObjectPayload *objects [[buffer(0)]],
    constant Meshlet *meshlets [[buffer(1)]],
    constant CameraData &camera [[buffer(2)]],
    grid_properties meshGrid,
    object_data ObjectPayload &payload [[payload]])
{
    ObjectPayload obj = objects[objectID];

    // Frustum cull the object's bounding sphere
    float4 center = float4(obj.boundingSphereCenter, 1.0) * obj.modelMatrix;
    float3 worldCenter = center.xyz;
    float radius = obj.boundingSphereRadius;

    // Simple frustum check: is the bounding sphere in front of the camera?
    float4 viewSpace = float4(worldCenter, 1.0) * camera.view;
    if (viewSpace.z + radius < -0.1) {
        // Object is behind the camera, cull it
        meshGrid.set_threadgroups_per_grid(MTLSizeMake(0, 0, 0));
        return;
    }

    // Set payload for mesh shader stage
    payload = obj;

    // Dispatch one mesh threadgroup per meshlet
    meshGrid.set_threadgroups_per_grid(MTLSizeMake(obj.meshletCount, 1, 1));
}

// ─── Mesh shader (second stage) ──────────────────────────────────────────────
// Runs once per meshlet. Generates vertices and triangles for the meshlet,
// performing per-meshlet frustum culling on the GPU.

[[mesh]]
void mesh_main(
    const object_data ObjectPayload &payload [[payload]],
    constant float3 *vertices [[buffer(0)]],
    constant float3 *normals [[buffer(1)]],
    constant float2 *uvs [[buffer(2)]],
    constant Meshlet *meshlets [[buffer(3)]],
    constant MeshletIndex *indices [[buffer(4)]],
    constant CameraData &camera [[buffer(5)]],
    uint meshletID [[threadgroup_position_in_grid]],
    uint threadID [[thread_index_in_threadgroup]],
    mesh_data_out<VertexOut, PrimitiveOut, 64, 64, topology::triangle> outMesh)
{
    uint globalMeshletID = payload.meshletOffset + meshletID;
    Meshlet meshlet = meshlets[globalMeshletID];

    // Per-meshlet frustum culling
    float4 center = float4(meshlet.center, 1.0) * payload.modelMatrix;
    float3 worldCenter = center.xyz;
    float4 viewSpace = float4(worldCenter, 1.0) * camera.view;

    if (viewSpace.z + meshlet.radius < -0.1) {
        // Meshlet is behind camera, output zero primitives
        if (threadID == 0) {
            outMesh.set_primitive_count(0);
        }
        return;
    }

    // Emit vertices
    uint vertexCount = meshlet.vertexCount;
    for (uint i = threadID; i < vertexCount; i += 64) {
        uint vertexIdx = meshlet.vertexOffset + i;
        float3 pos = vertices[vertexIdx];
        float3 normal = normals[vertexIdx];
        float2 uv = uvs[vertexIdx];

        VertexOut v;
        v.position = float4(pos, 1.0) * payload.modelMatrix * camera.viewProjection;
        v.normal = (float4(normal, 0.0) * payload.modelMatrix).xyz;
        v.uv = uv;
        v.color = float4(0.8, 0.8, 0.8, 1.0); // Default gray

        outMesh.set_vertex(i, v);
    }

    // Emit triangles
    uint triangleCount = meshlet.triangleCount;
    for (uint i = threadID; i < triangleCount; i += 64) {
        uint indexIdx = meshlet.triangleOffset + i;
        MeshletIndex idx = indices[indexIdx];

        // Local indices (relative to meshlet vertex start)
        outMesh.set_index(i * 3 + 0, idx.v0 - meshlet.vertexOffset);
        outMesh.set_index(i * 3 + 1, idx.v1 - meshlet.vertexOffset);
        outMesh.set_index(i * 3 + 2, idx.v2 - meshlet.vertexOffset);

        // Per-primitive normal (face normal)
        PrimitiveOut p;
        float3 v0 = vertices[idx.v0];
        float3 v1 = vertices[idx.v1];
        float3 v2 = vertices[idx.v2];
        p.normal = normalize(cross(v1 - v0, v2 - v0));
        outMesh.set_primitive(i, p);
    }

    if (threadID == 0) {
        outMesh.set_primitive_count(triangleCount);
    }
}

// ─── Fragment shader ─────────────────────────────────────────────────────────

[[fragment]]
float4 fragment_main(
    VertexOut in [[stage_in]],
    PrimitiveOut prim [[primitive]],
    constant CameraData &camera [[buffer(5)]])
{
    // Simple directional lighting
    float3 lightDir = normalize(float3(0.5, 0.8, 0.3));
    float3 normal = normalize(in.normal);

    float diff = max(dot(normal, lightDir), 0.0);
    float3 ambient = float3(0.3, 0.3, 0.3);

    float3 color = in.color.rgb * (ambient + diff * 0.7);

    // Simple depth-based fog
    float depth = in.position.z / in.position.w;
    float fogFactor = clamp((depth - 0.9) / 0.1, 0.0, 1.0);
    color = mix(color, float3(0.1, 0.1, 0.12), fogFactor);

    return float4(color, 1.0);
}
